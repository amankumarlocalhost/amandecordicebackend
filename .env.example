# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (CORS + Socket.IO origin check): storefront + admin panel
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Number of reverse-proxy hops in front of the app (1 behind Nginx/ALB) so client IPs are correct
TRUST_PROXY=0

# ---------------------------------------------------------------- data stores
# Must be a replica set (or Atlas) in production: checkout/payments use transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/crockery?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=50
# Production: false, and run `npm run sync-indexes` on each deploy instead
MONGODB_AUTO_INDEX=true
# Required in production (rate limits, queues, Socket.IO fan-out, caches)
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------- auth (generate each with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.yourstore.in
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# ---------------------------------------------------------------- Google Gemini (only AI provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional model tried once when the primary model's request fails
GEMINI_FALLBACK_MODEL=
# Optional stronger model for the admin assistant
GEMINI_ADMIN_MODEL=
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_CONCURRENCY=8
GEMINI_MAX_RETRIES=2
AI_DAILY_CUSTOMER_REQUESTS=60
AI_DAILY_ADMIN_REQUESTS=400

# ---------------------------------------------------------------- Razorpay (UPI only; COD needs no provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- media storage (local | s3 | cloudinary)
# Videos require cloudinary. local is development-only (refused in production).
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=crockery
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_VIDEO_SECONDS=120
# S3-compatible (when STORAGE_DRIVER=s3)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Public base URL / CDN in front of the bucket. Media awaiting review is stored under the private/
# prefix: the bucket policy MUST deny public reads on private/*.
OBJECT_STORAGE_PUBLIC_URL=

# ---------------------------------------------------------------- catalog media review
# Lifetime of signed private-preview links for media awaiting review (seconds)
MEDIA_PREVIEW_TTL_SEC=600
# Minimum width/height (px) for catalog images
MEDIA_MIN_DIMENSION=200
# Rejected / never-reviewed / replaced media is deleted after this many days (only if unused)
MEDIA_RETENTION_DAYS=30
# External image hosts admins may reference without uploading (comma-separated). Leave EMPTY in
# production so every storefront image goes through review. dev:memory sets demo hosts itself.
MEDIA_EXTERNAL_HOSTS=
# Official Unsplash API access key (https://unsplash.com/oauth/applications). Only the catalog
# image import uses it: photos are hotlinked and still go through media review before going live.
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------- storefront sync
# After an admin publishes, the backend POSTs changed cache tags to the storefront so its server
# cache refreshes immediately. Use the same random secret (32+ chars) in the storefront's env.
# FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=

# ---------------------------------------------------------------- messaging
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Decor Dice <no-reply@yourstore.in>
# none | console (console only logs in non-production; a real SMS/WhatsApp adapter must be added)
SMS_PROVIDER=console
WHATSAPP_PROVIDER=none

# ---------------------------------------------------------------- operations
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_MAX=15
# API processes: false in production (run src/worker.js separately)
RUN_WORKERS=true
RUN_SCHEDULERS=true
# Development only: returns OTPs / email tokens in API responses. Refused in production.
DEV_EXPOSE_OTP=false
# Serve Swagger UI in production (docs JSON is always at /api/docs.json)
# EXPOSE_DOCS=false
