{
  "name": "crockery-commerce-backend",
  "version": "1.0.0",
  "description": "Crockery, glassware, kitchenware & home decor e-commerce backend (Express, MongoDB, Redis, Socket.IO, Razorpay UPI/COD, Google Gemini)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory-server.js",
    "worker": "node src/worker.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "sync-indexes": "node scripts/sync-indexes.js",
    "docs:export": "node scripts/export-openapi.js",
    "loadtest:http": "node scripts/loadtest/http.js",
    "loadtest:sockets": "node scripts/loadtest/sockets.js",
    "audit:deps": "npm audit --omit=dev"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@google/genai": "^2.31.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.6",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/globalTeardown.js",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "testTimeout": 30000,
    "roots": [
      "<rootDir>/tests"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "private": true
}
